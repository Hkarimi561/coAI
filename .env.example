# Copy to .env and edit:  cp .env.example .env
# Values marked CHANGE-ME must be changed before exposing the app to anyone.

# ---------------------------------------------------------------- Ports / images
FRONTEND_PORT=3000
# Set to false when EMBEDDING_PROVIDER=ollama|openai (skips ~2GB of torch in the backend image)
INSTALL_LOCAL_EMBEDDINGS=true

# Build-time package sources. Change them if `pip install` / `npm install` time out inside `docker compose build`
# (e.g. company mirror). Leave the defaults on an open network.
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
NPM_REGISTRY=

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_USER=devops
POSTGRES_PASSWORD=CHANGE-ME-db-password
POSTGRES_DB=devops_ai

# ---------------------------------------------------------------- Auth
# Long random string, e.g.:  openssl rand -hex 48
JWT_SECRET=CHANGE-ME-long-random-secret
JWT_EXPIRE_HOURS=12
# Set true when the app is served over HTTPS
COOKIE_SECURE=false
# First admin is created at startup if the e-mail does not exist yet (or use: python -m app.cli create-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE-ME-admin-password
ADMIN_NAME=Administrator

# ---------------------------------------------------------------- LLM (local Qwen via Ollama by default)
# LLM_PROVIDER=ollama  -> native Ollama API:   LLM_BASE_URL=http://host.docker.internal:11434
# LLM_PROVIDER=openai  -> any OpenAI-compatible server (llama.cpp, vLLM, LM Studio, Ollama /v1):
#                         LLM_BASE_URL=http://host.docker.internal:11434/v1   (must include /v1)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=8192
LLM_TIMEOUT_S=180
# Ollama only: let reasoning models "think" before answering (slower). <think> blocks are always stripped.
LLM_THINK=false
# Extra LLM call that double-checks retrieved docs really answer the question (more accurate, slower)
LLM_GRADER_ENABLED=false

# ---------------------------------------------------------------- Embeddings
# local  -> sentence-transformers inside the backend container (downloads the model on first start)
# ollama -> EMBEDDING_BASE_URL (defaults to LLM_BASE_URL), e.g. EMBEDDING_MODEL=bge-m3
# openai -> OpenAI-compatible /embeddings endpoint
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ---------------------------------------------------------------- Retrieval thresholds (cosine similarity)
RETRIEVAL_TOP_K=5
MIN_CONTEXT_SCORE=0.72
DOC_SUFFICIENCY_SCORE=0.80
SOLUTION_SUFFICIENCY_SCORE=0.82
WEB_CACHE_SUFFICIENCY_SCORE=0.82

# ---------------------------------------------------------------- Docs store
# ./docs on the host is mounted at /data/docs in the container. Promoted docs go to docs/promoted/.
AUTO_INDEX_ON_START=true
CHUNK_MAX_CHARS=1400
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Web search
# searxng (self-hosted, default) | tavily | none
WEBSEARCH_PROVIDER=searxng
TAVILY_API_KEY=
WEBSEARCH_MAX_RESULTS=6
WEB_CACHE_TTL_HOURS=336

# ---------------------------------------------------------------- Docker inspection (read-only)
# Comma separated container names / globs the assistant may inspect. Empty = feature disabled.
# Only `inspect` (without env vars) and `logs --tail` are possible; nothing can be executed or restarted.
DOCKER_ALLOWED_CONTAINERS=
DOCKER_LOG_TAIL=120

# ---------------------------------------------------------------- CI (optional)
# none | github
CI_PROVIDER=none
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=
GITHUB_API_URL=https://api.github.com

# ---------------------------------------------------------------- Rate limits
CHAT_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_5MIN=10
